generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ═══════════════════════════════════════════════════
   SUPER ADMIN
   ═══════════════════════════════════════════════════ */

model SuperAdmin {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/* ═══════════════════════════════════════════════════
   PLANS & BILLING
   ═══════════════════════════════════════════════════ */

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  priceMonthly Float
  priceYearly Float?
  maxAssets   Int
  maxUsers    Int
  maxLocations Int
  features    String   // JSON array
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  status          String   @default("active")
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  billingCycle    String   @default("monthly")
  nextBillingDate DateTime
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments         Payment[]
  invoices         Invoice[]
}

model Payment {
  id              String   @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String   @default("TTD")
  method          String   @default("manual")
  status          String   @default("pending")
  reference        String?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String   @default("TTD")
  status          String   @default("pending")
  issuedAt        DateTime @default(now())
  dueAt           DateTime
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ═══════════════════════════════════════════════════
   ACCOUNTING (General Ledger per T&T rules)
   ═══════════════════════════════════════════════════ */

model LedgerAccount {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  code        String
  name        String
  accountType String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     LedgerEntry[]

  @@unique([code, tenantId])
}

model JournalEntry {
  id          String   @id @default(cuid())
  number      String
  description String
  date        DateTime
  status      String   @default("draft")
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     LedgerEntry[]

  @@unique([number])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  debit           Float    @default(0)
  credit          Float    @default(0)
  description     String?
  createdAt       DateTime @default(now())
}

/* ═══════════════════════════════════════════════════
   TENANT (institution)
   ═══════════════════════════════════════════════════ */

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String   @default("private")
  country     String   @default("Trinidad and Tobago")
  currency    String   @default("TTD")
  logo        String?
  contactName String?
  contactEmail String?
  contactPhone String?
  address     String?
  isActive    Boolean  @default(true)
  activatedAt DateTime?
  deactivatedAt DateTime?
  deactivationReason String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscription Subscription?
  settings     TenantSettings?
  users       User[]
  assets      Asset[]
  categories  Category[]
  locations   Location[]
  inventorySessions InventorySession[]
  payments    Payment[]
  invoices    Invoice[]
  notifications Notification[]
  maintenances Maintenance[]
  documents   Document[]
  depreciations Depreciation[]
  dataMigrations DataMigration[]
  journalEntries JournalEntry[]
  ledgerAccounts LedgerAccount[]
  checkouts      AssetCheckout[]
  reservations   Reservation[]
  workOrders    WorkOrder[]
}

/* ═══════════════════════════════════════════════════
   TENANT SETTINGS (branding, integrations, AI, WhatsApp)
   ═══════════════════════════════════════════════════ */

model TenantSettings {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Branding
  primaryColor    String   @default("#0f766e")
  secondaryColor  String   @default("#14b8a6")
  accentColor     String   @default("#f59e0b")
  fontFamily      String   @default("Inter")
  logoUrl         String?
  faviconUrl      String?
  customDomain    String?
  loginBackground String?

  // WhatsApp Business API
  whatsappEnabled     Boolean  @default(false)
  whatsappApiUrl      String?
  whatsappApiToken    String?
  whatsappPhoneNumber  String?
  whatsappTemplateLang String  @default("en")

  // AI Assistant
  aiEnabled         Boolean  @default(false)
  aiProvider        String   @default("openai") // openai, anthropic, google
  aiApiKey          String?
  aiModel           String   @default("gpt-4o-mini")
  aiTemperature     Float    @default(0.7)
  aiSystemPrompt    String   @default("You are a helpful asset management assistant for {tenantName}. Help users manage their assets, run inventory checks, and generate reports.")

  // Notifications
  emailNotificationsEnabled  Boolean @default(true)
  whatsappNotificationsEnabled Boolean @default(false)
  inAppNotificationsEnabled  Boolean @default(true)
  lowStockAlertsEnabled      Boolean @default(false)
  maintenanceAlertsEnabled   Boolean @default(true)
  warrantyAlertsEnabled      Boolean @default(true)

  // Inventory
  defaultDepreciationMethod String @default("straight_line") // straight_line, declining_balance
  defaultUsefulLifeYears   Int    @default(5)
  autoGenerateQRCodes      Boolean @default(true)
  requirePhotoOnCreate     Boolean @default(false)

  // Security
  sessionTimeoutMinutes Int @default(60)
  requireTwoFactor     Boolean @default(false)
  passwordMinLength    Int    @default(8)
  passwordRequireUpper Boolean @default(true)
  passwordRequireNumber Boolean @default(true)
  passwordRequireSpecial Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ═══════════════════════════════════════════════════
   USER (with JWT auth)
   ═══════════════════════════════════════════════════ */

model User {
  id            String   @id @default(cuid())
  email         String
  passwordHash  String
  name          String
  role          String   @default("user")
  avatar        String?
  phone         String?
  department    String?
  jobTitle      String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  inventorySessions InventorySession[]
  refreshTokens RefreshToken[]
  notifications  Notification[]
  checkouts     AssetCheckout[]
  reservations  Reservation[]
  approvedReservations Reservation[] @relation("ReservationApprover")
  requestedWorkOrders  WorkOrder[] @relation("RequestedWorkOrders")
  assignedWorkOrders   WorkOrder[] @relation("AssignedWorkOrders")
  approvedWorkOrders   WorkOrder[] @relation("ApprovedWorkOrders")
  rejectedWorkOrders   WorkOrder[] @relation("RejectedWorkOrders")

  @@unique([email, tenantId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  code        String
  color       String   @default("#6366f1")
  icon        String   @default("Package")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@unique([name, tenantId])
  @@unique([code, tenantId])
}

model Location {
  id          String   @id @default(cuid())
  name        String
  code        String
  address     String?
  parentId    String?
  parent      Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets              Asset[]
  inventorySessions    InventorySession[]
  workOrders           WorkOrder[]

  @@unique([name, tenantId])
}

model Asset {
  id              String   @id @default(cuid())
  qrCode          String
  tagNumber       String
  name            String
  description     String?
  serialNumber    String?
  brand           String?
  model           String?
  purchaseDate    DateTime?
  purchasePrice   Float?
  currentValue    Float?
  residualValue   Float?
  warrantyExpiry  DateTime?
  usefulLifeYears Int?
  depreciationMethod String?
  status          String   @default("active")
  condition       String   @default("good")
  assignedTo      String?
  notes           String?
  photo           String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs       AuditLog[]
  inventoryItems  InventoryItem[]
  maintenances    Maintenance[]
  documents       Document[]
  depreciations Depreciation[]
  checkouts    AssetCheckout[]
  reservations Reservation[]
  workOrders   WorkOrder[]

  @@unique([qrCode, tenantId])
  @@unique([tagNumber, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  details     String?
  ipAddress   String?
  userAgent   String?
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId    String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

model InventorySession {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("in_progress")
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  notes       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  totalExpected Int   @default(0)
  totalScanned  Int   @default(0)
  totalMissing   Int   @default(0)
  totalExtra    Int   @default(0)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       InventoryItem[]
}

model InventoryItem {
  id                String   @id @default(cuid())
  qrCode            String?
  assetId           String?
  asset             Asset?   @relation(fields: [assetId], references: [id])
  sessionId         String
  session           InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  discrepancyType   String?
  discrepancyNote   String?
  scannedAt         DateTime @default(now())
  synced            Boolean  @default(false)
}

model SyncQueue {
  id          String   @id @default(cuid())
  operation   String
  entity      String
  entityId    String?
  payload     String
  status      String   @default("pending")
  attempts    Int      @default(0)
  error       String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
}

/* ═══════════════════════════════════════════════════
   NOTIFICATIONS
   ═══════════════════════════════════════════════════ */

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?  // null = broadcast to all tenant users
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String   // asset_expired, maintenance_due, warranty_expiring, inventory_completed, system, custom
  title       String
  message     String
  data        String?  // JSON payload for actions
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, userId, isRead, createdAt])
}

/* ═══════════════════════════════════════════════════
   MAINTENANCE
   ═══════════════════════════════════════════════════ */

model Maintenance {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type        String   @default("preventive") // preventive, corrective, emergency
  status      String   @default("scheduled") // scheduled, in_progress, completed, cancelled
  title       String
  description String?
  scheduledDate DateTime?
  completedDate DateTime?
  cost        Float?
  vendor      String?
  vendorContact String?
  performedBy String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, assetId, status])
  @@index([tenantId, status, scheduledDate])
}

/* ═══════════════════════════════════════════════════
   DOCUMENT ATTACHMENTS
   ═══════════════════════════════════════════════════ */

model Document {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  fileName    String
  originalName String
  mimeType    String
  fileSize    Int      // bytes
  fileUrl     String   // path to file storage
  category    String   @default("other") // invoice, warranty, manual, photo, contract, insurance, other
  description String?
  version     Int      @default(1)
 uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, assetId])
}

/* ═══════════════════════════════════════════════════
   DEPRECIATION
   ═══════════════════════════════════════════════════ */

model Depreciation {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fiscalYear        Int
  periodNumber      Int      @default(1)
  method            String   // straight_line, declining_balance
  purchasePrice     Float
  residualValue     Float    @default(0)
  usefulLifeYears   Int
  depreciationRate  Float    // annual rate
  periodDepreciation Float   // this period amount
  accumulatedDepreciation Float @default(0)
  bookValue         Float    // after this period
  status            String   @default("calculated") // calculated, posted, reversed
  calculatedAt      DateTime @default(now())
  postedAt          DateTime?
  journalEntryId    String?

  @@unique([assetId, fiscalYear, periodNumber])
  @@index([tenantId, fiscalYear])
}

/* ═══════════════════════════════════════════════════
   DATA MIGRATION
   ═══════════════════════════════════════════════════ */

model DataMigration {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceType    String   // csv, excel, json, snipeit, asset_panda, fixrm
  entityType    String   // assets, categories, locations, users
  fileName      String
  fileSize      Int
  totalRows     Int
  processedRows Int      @default(0)
  failedRows    Int      @default(0)
  status        String   @default("pending") // pending, processing, completed, failed, rolled_back
  mappingConfig String   // JSON: source column -> target field
  errors        String?  // JSON array of row errors
  startedAt     DateTime?
  completedAt   DateTime?
  rolledBackAt  DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
}

/* ═══════════════════════════════════════════════════
   CHECK-INS / CHECK-OUTS
   ═══════════════════════════════════════════════════ */

model AssetCheckout {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedOutAt DateTime @default(now())
  expectedReturnAt DateTime?
  returnedAt  DateTime?
  conditionAtCheckout String?
  conditionAtReturn   String?
  notes       String?
  status      String   @default("checked_out") // checked_out, returned, overdue
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, assetId, status])
  @@index([tenantId, userId, status])
  @@index([tenantId, status, expectedReturnAt])
}

/* ═══════════════════════════════════════════════════
   RESERVATIONS
   ═══════════════════════════════════════════════════ */

model Reservation {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("pending") // pending, approved, rejected, fulfilled, completed, cancelled
  approvedBy  String?
  approvedByUser User?   @relation("ReservationApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, assetId, status])
  @@index([tenantId, userId, status])
  @@index([tenantId, status, startDate])
}

/* ═══════════════════════════════════════════════════
   WORK ORDERS (with approval workflow)
   ═══════════════════════════════════════════════════ */

model WorkOrder {
  id            String   @id @default(cuid())
  title         String
  description   String?
  priority      String   @default("medium")
  status        String   @default("pending")
  assetId       String?
  locationId    String?
  requestedBy   String
  assignedTo    String?
  approvedBy    String?
  approvedAt    DateTime?
  rejectedBy    String?
  rejectedAt    DateTime?
  rejectedReason String?
  startedAt     DateTime?
  completedAt   DateTime?
  closedAt      DateTime?
  closedNotes   String?
  estimatedCost  Decimal? @db.Decimal(12,2)
  actualCost    Decimal? @db.Decimal(12,2)
  dueDate       DateTime?
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  asset     Asset?  @relation(fields: [assetId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])
  requester User    @relation("RequestedWorkOrders", fields: [requestedBy], references: [id])
  assignee  User?   @relation("AssignedWorkOrders", fields: [assignedTo], references: [id])
  approver  User?   @relation("ApprovedWorkOrders", fields: [approvedBy], references: [id])
  rejector  User?   @relation("RejectedWorkOrders", fields: [rejectedBy], references: [id])
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, assetId])
  @@index([tenantId, requestedBy])
  @@index([tenantId, assignedTo])
  @@index([tenantId, dueDate])
}