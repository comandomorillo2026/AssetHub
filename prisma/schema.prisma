generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ═══════════════════════════════════════════════════
   SUPER ADMIN
   ═══════════════════════════════════════════════════ */

model SuperAdmin {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/* ═══════════════════════════════════════════════════
   PLANS & BILLING
   ═══════════════════════════════════════════════════ */

model Plan {
  id          String   @id @default(cuid())
  name        String   // Starter, Professional, Enterprise
  slug        String   @unique
  priceMonthly Float    // in TTD
  priceYearly Float?   // in TTD (optional annual discount)
  maxAssets   Int
  maxUsers    Int
  maxLocations Int
  features    String   // JSON array of feature strings
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id])
  status          String   @default("active") // active, past_due, cancelled, trial
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  billingCycle    String   @default("monthly") // monthly, yearly
  nextBillingDate DateTime
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments         Payment[]
  invoices         Invoice[]
}

model Payment {
  id              String   @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String   @default("TTD")
  method          String   @default("manual") // manual, bank_transfer, credit_card, online
  status          String   @default("pending") // pending, completed, failed, refunded
  reference        String?  // bank reference / receipt number
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String   @default("TTD")
  status          String   @default("pending") // pending, paid, overdue, cancelled
  issuedAt        DateTime @default(now())
  dueAt           DateTime
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ═══════════════════════════════════════════════════
   ACCOUNTING (General Ledger per T&T rules)
   ═══════════════════════════════════════════════════ */

model LedgerAccount {
  id          String   @id @default(cuid())
  code        String   // e.g. 1000, 1200, 2000 per T&T chart of accounts
  name        String   // e.g. "Cash at Bank", "Accounts Receivable"
  accountType String   // asset, liability, equity, revenue, expense
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     LedgerEntry[]
}

model JournalEntry {
  id          String   @id @default(cuid())
  number      String   @unique // e.g. JE-2026-001
  description String
  date        DateTime
  status      String   @default("draft") // draft, posted, reversed
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     LedgerEntry[]
}

model LedgerEntry {
  id              String   @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  debit           Float    @default(0)
  credit          Float    @default(0)
  description     String?
  createdAt       DateTime @default(now())
}

/* ═══════════════════════════════════════════════════
   TENANT (institution) — the "apartment"
   ═══════════════════════════════════════════════════ */

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String   @default("private") // government, private, education, insurance, credit_union
  country     String   @default("Trinidad and Tobago")
  currency    String   @default("TTD")
  logo        String?
  contactName String?
  contactEmail String?
  contactPhone String?
  address     String?
  isActive    Boolean  @default(true)
  activatedAt DateTime?
  deactivatedAt DateTime?
  deactivationReason String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscription Subscription?
  users       User[]
  assets      Asset[]
  categories  Category[]
  locations   Location[]
  inventorySessions InventorySession[]
  payments    Payment[]
  invoices    Invoice[]
}

model User {
  id            String   @id @default(cuid())
  email         String
  passwordHash  String
  name          String
  role          String   @default("user") // admin, auditor, user
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  inventorySessions InventorySession[]

  @@unique([email, tenantId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  code        String
  color       String   @default("#6366f1")
  icon        String   @default("Package")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@unique([name, tenantId])
  @@unique([code, tenantId])
}

model Location {
  id          String   @id @default(cuid())
  name        String
  code        String
  address     String?
  parentId    String?
  parent      Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets              Asset[]
  inventorySessions    InventorySession[]

  @@unique([name, tenantId])
}

model Asset {
  id              String   @id @default(cuid())
  qrCode          String   @unique
   tagNumber       String
  name            String
  description     String?
  serialNumber    String?
  brand           String?
  model           String?
  purchaseDate    DateTime?
  purchasePrice   Float?
  currentValue    Float?
  warrantyExpiry  DateTime?
  status          String   @default("active")
  condition       String   @default("good")
  assignedTo      String?
  notes           String?
  photo           String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs       AuditLog[]
  inventoryItems  InventoryItem[]

  @@unique([tagNumber, tenantId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  details     String?
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId    String?
  createdAt   DateTime @default(now())
}

model InventorySession {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("in_progress")
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  notes       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  totalExpected Int   @default(0)
  totalScanned  Int   @default(0)
  totalMissing   Int   @default(0)
  totalExtra    Int   @default(0)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       InventoryItem[]
}

model InventoryItem {
  id                String   @id @default(cuid())
  qrCode            String?
  assetId           String?
  asset             Asset?   @relation(fields: [assetId], references: [id])
  sessionId         String
  session           InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  discrepancyType   String?
  discrepancyNote   String?
  scannedAt         DateTime @default(now())
  synced            Boolean  @default(false)
}

model SyncQueue {
  id          String   @id @default(cuid())
  operation   String
  entity      String
  entityId    String?
  payload     String
  status      String   @default("pending")
  attempts    Int      @default(0)
  error       String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
