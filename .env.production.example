# AssetHub - Production Environment Variables
# Copy this to Vercel Environment Variables

# Database (PostgreSQL - Supabase/Neon/Render)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# JWT Authentication
JWT_SECRET="generate-a-32-char-random-string-here"
JWT_REFRESH_SECRET="generate-another-32-char-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# WiPay (Caribbean Payment Gateway)
WIPAY_API_KEY="your-wipay-api-key"
WIPAY_MERCHANT_ID="your-wipay-merchant-id"

# Encryption (for sensitive config storage)
ENCRYPTION_KEY="generate-a-32-char-encryption-key"

# Optional: Custom domain
NEXT_PUBLIC_APP_URL="https://your-domain.com"
