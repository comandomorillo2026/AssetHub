# AssetHub - Production Environment Variables
# Copy this to Vercel Environment Variables

# Database (PostgreSQL - Supabase/Neon/Render)
DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-PASSWORD]@db.pnsdsqihlwecvxhhddfm.supabase.co:5432/postgres

# JWT Authentication
JWT_SECRET=[GENERATE-A-RANDOM-64-CHAR-SECRET]
JWT_REFRESH_SECRET=[GENERATE-A-RANDOM-64-CHAR-SECRET]
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# WiPay (Caribbean Payment Gateway)
WIPAY_API_KEY="your-wipay-api-key"
WIPAY_MERCHANT_ID=[YOUR-WIPAY-MERCHANT-ID]

# Encryption (for sensitive config storage)
ENCRYPTION_KEY=[GENERATE-A-RANDOM-32-CHAR-KEY]

# Optional: Custom domain
NEXT_PUBLIC_APP_URL="https://your-domain.com"
